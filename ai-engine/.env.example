# AI 引擎环境变量示例。复制为 .env 后按需修改（.env 已被 .gitignore 忽略）。
# 键名与 app/services/ 下各模块 os.getenv() 的读取点一一对应，改名前请先查代码。

# ── Redis 队列（与后端共用同一实例；后端用 db 9）─────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=9
# 队列键名需与后端 TaskService.dispatch / RedisSubscriberService 严格一致
TASK_QUEUE_KEY=wildlife:tasks
RESULT_QUEUE_KEY=wildlife:results

# ── 模型权重 ────────────────────────────────────────────────────────────────
# 权重根目录，其下按版本分子目录：models/<version>/best.pt
MODEL_ROOT=models
# 服务启动时默认启用的版本（该目录下必须存在 best.pt，否则会走下面的回退权重）
ACTIVE_MODEL_VERSION=wildlife-v1.0
# 备用权重：当 ACTIVE_MODEL_VERSION 目录下缺少 best.pt 时回退加载它
YOLO_MODEL_PATH=models/wildlife-v1.0/best.pt

# ── 推理参数（无 GPU 时靠 BATCH_SIZE 控制批量，避免内存打爆）────────────────
# 留空 = 交给 ultralytics 自动选择设备；也可显式填 cuda:0 / cpu
YOLO_DEVICE=
YOLO_CONF_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.5
YOLO_IMAGE_SIZE=640
YOLO_MAX_DETECTIONS=300
# 逗号分隔的类别白名单，留空表示不过滤
YOLO_TARGET_CLASSES=

# ── 消费并发 ────────────────────────────────────────────────────────────────
# 每个批次送进模型的图像张数
BATCH_SIZE=8
# 消费者线程数。注意：>1 时多个线程会共用同一个 detector 实例，当前实现下不建议调大
RECOGNITION_WORKERS=1